#!/bin/bash

# Open the Sporetify app: focus its window if it is already running,
# otherwise start it. With a Spotify link as the argument (spotify:album:...
# or https://open.spotify.com/...), also show that link.

ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
link="$1"

window=$(hyprctl clients -j 2>/dev/null | jq -r '[.[] | select(.class == "sporetify")][0] | select(. != null) | "\(.address) \(.pid)"')
if [[ -n $window ]]; then
  read -r address pid <<<"$window"
  [[ -z $link ]] || qs ipc --pid "$pid" call sporetify.app open "$link" >/dev/null 2>&1
  hyprctl dispatch "hl.dsp.focus({ window = \"address:$address\" })" >/dev/null 2>&1 ||
    hyprctl dispatch focuswindow "address:$address" >/dev/null 2>&1
  exit 0
fi

SPORETIFY_OPEN="$link" exec setsid qs -p "$ROOT/App.qml" >/dev/null 2>&1
